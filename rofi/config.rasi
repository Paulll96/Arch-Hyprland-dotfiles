@import "~/.config/rofi/colors.rasi"

* {
    background:     @surface;
    background-alt: @surface-container;
    foreground:     @on-surface;
    selected:       @primary;
    active:         @secondary;
    urgent:         @error;

    font: "JetBrainsMono Nerd Font 12";

    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 25%;
    location: center;
    height: 55%;
    border: 2px;
    padding: 12px;
    border-color: @primary;

    border-radius: 18px;
    transparency: "real";
    background-color: #0f1416bb;
}




mainbox {
    padding: 8px;
}

inputbar {
    background-color: @surface-container-high;

    border-radius: 16px;

    padding: 12px;

    margin: 0px 0px 14px 0px;
}
prompt {
    enabled: false;
}

entry {
    text-color: @foreground;
    placeholder: "Search...";
    placeholder-color: @outline;
}

listview {
    lines: 7;
    columns: 1;

    spacing: 8px;

    scrollbar: false;
}

element {

    padding: 6px;

    border-radius: 13px;

    background-color: transparent;
}
element selected {
    background-color: @primary;
    text-color: @foreground;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;

    horizontal-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;
}



