{
    "layer": "top",
    
    "modules-left": ["custom/launcher","custom/powerprofile","hyprland/workspaces"],

    "modules-center":["clock"],
    "modules-right": ["custom/stopwatch","network","pulseaudio","battery"],
   //"modules-center":["custom/launcher","custom/powerprofile","hyprland/workspaces","clock","custom/stopwatch","network","pulseaudio","battery"],
    "custom/launcher": {
	    "format": "",
    "on-click": "exec /home/luap/.config/hypr/scripts/powermenu.sh",
    	"tooltip":false

   
    },
    "battery": {
    // "states": {
    //     "warning": 10,
    //     "critical": 5
    // },

    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""]
    },
    
    "clock": {
        "format": "{:%I:%M %p}",
        
        "format-alt": "{:%a, %d %b  %I:%M %p}",
	"tooltip":false
    },
"custom/stopwatch": {
    "exec": "~/.config/waybar/scripts/stopwatch.sh",
    "interval": 1,
    "return-type": "json",

    "on-click": "~/.config/waybar/scripts/stopwatchctl.sh toggle",

    "on-click-right": "~/.config/waybar/scripts/stopwatchctl.sh reset"
},
    
  "custom/powerprofile": {
    "exec": "/home/luap/.config/waybar/scripts/powerprofile.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true
},
    "hyprland/workspaces":{
        
	"format": "{name}",
	
    "persistent-workspaces": {
            "*": 5, // 5 workspaces by default on every monitor
            //"HDMI-A-1": 3 // but only three on HDMI-A-1
      }
    },
    "hyprland/window": {
    "format": "",
   
    "separate-outputs": true
    },
"pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "phone-muted": "",
        "portable": "",
        "car": "",
        "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
},
    // "network": {
        
    //     "format": "{ifname}",
    //     "format-wifi": "{essid}  ",
    //     "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    //     "format-disconnected": "", //An empty format will hide the module.
    //     "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    //     "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    //     "tooltip-format-ethernet": "{ifname} ",
    //     "tooltip-format-disconnected": "Disconnected",
    //     "max-length": 50
    // }
    "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",

    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ipaddr}",
    "tooltip-format-disconnected": "Disconnected"
    }
}
